# ===== novel_workflow 全局配置 =====
# 复制为 config.yaml, 改成你的实际值
# 优先从 env ($VAR) 读, 例 ${REVIEW_UI_PASSWORD}

# === 运行时 ===
runtime:
  # doctor 的 Python 版本下限。
  # 这**不是**"代码实际需要的最低版本", 而是"CI 门禁覆盖到的版本"(CI 跑 3.12/3.14)。
  # 两者可以不同: 生产 systemd 跑 3.11 时把这里设成 3.11, doctor 就不会误报,
  # 同时低于它仍然只报 warn —— 真正跑不动的是硬地板 3.9。
  min_python: "3.12"

# === LLM ===
llm:
  api_base: ${LLM_API_BASE:-http://127.0.0.1:60443/v1}
  default_model: ${LLM_DEFAULT_MODEL:-Qwen3.6-35B-A3B-UD-Q4_K_M.gguf}
  # 备用模型 (按顺序回退)
  fallback_models:
    - Qwythos-9B-Claude-Mythos-5-1M-MTP-Q8_0.gguf
  timeout_sec: ${LLM_TIMEOUT_SEC:-600}
  max_retries: ${LLM_MAX_RETRIES:-3}
  # 推理模型(reasoning model)的 token 预算下限。推理模型先写思维链再写正文,
  # 4096 会被思维链吃光 -> finish_reason=length + 正文为空(2026-10-02 实测)。
  # 非推理模型 / 本地小上下文模型保持 0(不干预)。
  min_max_tokens: ${LLM_MIN_MAX_TOKENS:-0}

# === review_ui ===
review_ui:
  host: 127.0.0.1
  port: 21199
  # Basic Auth (公网入口)
  # 默认关闭 (本地开发免密). 公网部署时改 enabled: true 并设密码:
  #   1. 设环境变量 REVIEW_UI_PASSWORD=你的强密码
  #   2. 或者直接改 password: 你的密码 (不建议写进 git)
  auth:
    enabled: false
    user: ${REVIEW_UI_USER:-weichao}
    password: ${REVIEW_UI_PASSWORD:-}
  # 反向代理前缀 (nginx 配置, 用于 url_for 自动生成 /novel/...)
  proxy_prefix: /novel

# === 备份 ===
backup:
  enabled: true
  retention_days: ${BACKUP_RETENTION_DAYS:-7}
  schedule_time: ${BACKUP_TIME:-03:00}
  # 不压缩 (JSON 已经够小), 改 tar.gz 改成 true 可省 80% 空间
  compress_tar: true

# === 日志 ===
logging:
  level: ${LOG_LEVEL:-INFO}
  file: ${LOG_FILE_PATH:-logs/novel_workflow.log}
  rotation: ${LOG_ROTATION:-10MB x 5}

# === 高级 (一般不改) ===
projects:
  # 项目目录根 (per-book 子目录)
  root: projects
  # 注: 旧版这里有个 normalize_ascii_book_name, 全仓零消费, 已于 2026-10-02 移除。
  # 中文书名目录实测正常(PS 5.1 GBK 的坑在命令行传参, 不在文件路径)。

# === v1.1 Web 流水线面板 ===
dashboard:
  enabled: true
  log_tail_default: 100        # /api/pipeline/logs 默认返回行数
  log_max_buffer: 500          # SSE 客户端 buffer 上限
  metrics_retention_days: 30   # metrics.jsonl 清理阈值 (启动时)
  cancel_grace_seconds: 5      # cancel 后等子进程退出的宽限
  stream_poll_interval: 1.0    # SSE 轮询 log 文件间隔 (秒)
